\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Separating the full Anderson impurity Hamiltonian $\hat  {H}_{NO}$ defined on the natural orbitals into four parts $\hat  {H}_I$, $\hat  {H}_c$, $\hat  {H}_v$, and $V$ . Each Hamiltonian acts on the sites enclosed by its corresponding box. The hybridization operator $V$ (dashed bonds) connects $\hat  {H}_I$ to $\hat  {H}_c$ and $\hat  {H}_v$ \cite  {lu_natural-orbital_2019}.\relax }}{4}{figure.caption.2}\protected@file@percent }
\newlabel{fig:no_cut}{{2}{4}{Separating the full Anderson impurity Hamiltonian $\hamiltonian _{NO}$ defined on the natural orbitals into four parts $\hamiltonian _I$, $\hamiltonian _c$, $\hamiltonian _v$, and $V$ . Each Hamiltonian acts on the sites enclosed by its corresponding box. The hybridization operator $V$ (dashed bonds) connects $\hamiltonian _I$ to $\hamiltonian _c$ and $\hamiltonian _v$ \cite {lu_natural-orbital_2019}.\relax }{figure.caption.2}{}}
